---
import CardContacto from '../components/CardContacto.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import LogosExternos from '../components/LogosExternos.astro';
import Navbar from '../components/Navbar.astro';
import PreguntasRespuesta from '../components/PreguntasRespuesta.astro';
import ProcesosTrabajo from '../components/ProcesosTrabajo.astro';
import Proyectos from '../components/Proyectos.astro';
import SeccionBlog from '../components/SeccionBlog.astro';
import Servicios from '../components/Servicios.astro';
import VideoContainer from '../components/VideoContainer.astro';
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";
---

<Layout>
	 <Navbar />
	 <main role="main">
		<Hero />
		<VideoContainer />
		<LogosExternos />
		<Servicios/>
		<div class="max-w-7xl mx-auto flex flex-col items-center mt-32">
			<p class="font-Anton text-3xl leading-12 
				bg-linear-to-r from-primary-light via-primary-dark to-primary-light
				bg-size-[300%_300%] bg-clip-text text-transparent animate-gradiente border-2 border-gray-dark p-5 rounded-2xl">

				“Especializo en desarrollo web informativo e institucional”
			</p>
		</div>
		<Proyectos />
		<ProcesosTrabajo />
		<PreguntasRespuesta/>
		<SeccionBlog />
		<CardContacto/>
	 </main>
	<Footer />
</Layout>
