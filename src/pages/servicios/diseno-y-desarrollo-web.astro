---

import Footer from "../../components/Footer.astro";
import Navbar from "../../components/Navbar.astro";
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";

---
<Layout >
    <Navbar />
    <main class="max-w-7xl mx-auto flex flex-col p-4 gap-32 mt-32">
        <section class="flex flex-col items-start gap-3">
            <h1 class="font-Anton text-3xl leading-12 
            bg-linear-to-r from-primary-light via-primary-dark to-primary-light
            bg-size-[300%_300%]
            bg-clip-text text-transparent
            animate-gradiente">
            Diseño y desarrollo web
            </h1>

            <p class="max-w-xl font-Lexend text-gray text-base leading-relaxed">
            Creamos sitios web rápidos, modernos y optimizados para SEO, diseñados para atraer clientes, generar confianza y convertir visitas en resultados reales.
            </p>
        </section>

        <div>
            <h2>
                
            </h2>
        </div>
    </main>
    <Footer />
</Layout>