---
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

---
<Layout >
    <Navbar />
    <main class="max-w-7xl mx-auto flex flex-col p-4 gap-32 mt-32">
        <section class="flex flex-col items-center gap-3">
            <h1 class="font-Anton text-3xl leading-12 
            bg-linear-to-r from-primary-light via-primary-dark to-primary-light
            bg-size-[300%_300%]
            bg-clip-text text-transparent
            animate-gradiente">
                Nosotros
            </h1>

            <p class="max-w-xl font-Lexend text-gray text-base leading-relaxed">
            ¿Tienes un proyecto en mente? Escríbenos y te ayudaremos a hacerlo realidad con soluciones digitales modernas, rápidas y efectivas.
            </p>
        </section>
    </main>
    <Footer />
</Layout>