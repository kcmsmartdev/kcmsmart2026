---
import { Icon } from "astro-icon/components";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import Layout from "../layouts/Layout.astro";

import "../styles/global.css";


const beneficios =[

    {titulo:"Confianza desde el primer vistazo", 
    desc:"Tu sitio web proyectará una imagen profesional, clara y coherente con tu marca desde el primer contacto.",
    icon:"mdi:coffee-to-go"},

    {titulo:"Experiencia funcional", 
    desc:"Diseñamos webs rápidas, intuitivas y fáciles de usar, pensadas para ofrecer una navegación fluida en cualquier dispositivo.",
    icon:"mdi:arrow-bottom-left-bold-box"},

    {titulo:"Acompañamiento real", 
    desc:"Te guiamos durante todo el proceso, desde la planificación hasta la publicación, asegurando que tu web cumpla su propósito.",
    icon:"mdi:account-group"},

    {titulo:"Optimización desde la base", 
    desc:"Cada sitio se construye con buenas prácticas de rendimiento y SEO técnico, listo para posicionarse correctamente en buscadores.",
    icon:"mdi:slope-uphill"},


]

---
<Layout >
    <Navbar />
    <main class="max-w-7xl mx-auto flex flex-col p-4 gap-32 mt-32">
       <section class="flex flex-col items-start gap-3">
            <h1 class="font-Anton text-3xl leading-12 
            bg-linear-to-r from-primary-light via-primary-dark to-primary-light
            bg-size-[300%_300%]
            bg-clip-text text-transparent
            animate-gradiente">
                Nosotros
            </h1>

            <p class="max-w-xl font-Lexend text-gray text-base leading-relaxed">
             En KCM SMART creamos sitios web rápidos, funcionales y optimizados para SEO, diseñados para proyectar profesionalismo y fortalecer la presencia digital de tu negocio.
            </p>
        </section>

        <div class="flex flex-col gap-4">
            <section>
                <h2 class="font-Lexend text-white text-2xl">Beneficios de trabajar con nosotros</h2>
            </section>
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-2">
            {
                beneficios.map((e)=>{

                    return(

                    <section class="group min-h-56  flex flex-col gap-3 bg-gray p-5 rounded-2xl border-4 border-b-primary lg:border-transparent hover:border-b-primary shadow-xl lg:hover:shadow-gray-dark/35">
                        <div class="w-fit group-hover:p-2 group-hover:bg-black group-hover:rounded-4xl group-hover:scale-105 transition-all duration-300 eas">
                            <Icon name={e.icon}
                                class="size-7 transition-transform duration-500  
                                 text-black  group-hover:text-white " />
                        
                        </div>
                        <h3 class="font-Anton text-base">
                            {e.titulo}
                        </h3>
                        <p class="font-Lexend text-sm text-black/80">
                            {e.desc}
                        </p>
                    </section>

                    )
                })
            }
        </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2">
            <div>

            </div>

            <section class="flex flex-col gap-4">
                <span class="font-Anton  text-base font-light text-white">Sobre KCM SMART</span>

                <h2 class="font-Lexend text-3xl font-bold text-white leading-tight">
                    La historia detrás del código
                </h2>

                <p class="text-gray font-Lexend text-base">
                    Mi nombre es <strong class="text-white">Kener Cotrina</strong>, fundador de KCM SMART. Mi viaje en el desarrollo web comenzó desde muy joven con una misión clara: crear sitios web bien construidos, rápidos y funcionales, accesibles para negocios que buscan una presencia digital profesional.
                </p>

                <p class="text-gray font-Lexend text-base">
                    Con el tiempo entendí que una web no solo debe verse bien, sino también estar bien desarrollada, optimizada y pensada para el usuario.
                </p>

                <p class="text-gray font-Lexend text-base">
                   En KCM SMART trabajamos cada proyecto con enfoque técnico y estratégico, priorizando rendimiento, claridad y escalabilidad. Creemos en hacer las cosas bien desde la base: código limpio, velocidad, estructura sólida y una experiencia que realmente represente a tu negocio.
                </p>

                <div class="flex flex-col mt-8">
                    <p class="font-Lexend text-2xl text-white leading-tight tracking-widest">Kener Cotrina</p>
                    <p class="font-Lexend text-primary-light text-sm">FOUNDER & LEAD DEVELOPER</p>
                </div>
            </section>

        </div>

        <div class=" bg-primary-light flex flex-col items-center justify-center rounded-2xl min-h-72 py-7 lg:min-h-96 gap-7 mt-32">

            <p class="max-w-2xl text-black font-Anton text-center text-3xl lg:text-4xl">
                Estamos listo para ayudarte a crear una web profesional que impulse tu negocio.
            </p>

            <a href="/contactanos"
            class="group font-Anton text-base  lg:text-xl text-black flex gap-5 py-4 px-16  border-2 border-black rounded-2xl hover:border-transparent 
            hover:bg-black hover:text-primary-light  hover:rounded-4xl
            transform duration-500 ease-in-out">

                CONTÁCTANOS

                <Icon name="icon-park-outline:arrow-right-up" class="size-7  rotate-45 lg:rotate-0   group-hover:rotate-45 transition-transform duration-500 ease-in-out" />
            </a>

        </div>
    </main>
    <Footer />
</Layout>