---
import { Icon } from 'astro-icon/components';
import imgServicio1 from "../assets/img-servicio-1.png"
import imgServicio2 from "../assets/img-servicio-2.png"
import imgServicio3 from "../assets/img-servicio-3.png"
import { check } from 'astro:schema';

const currentPath = Astro.url.pathname;

interface submenu {
    name: string,
    href: string,
    img: ImageMetadata,
}

interface menuList {
    name: string,
    href: string,
    children?: submenu[],
}

const MenuList: menuList[] = [
    {name:"Inicio", href:"/"},
    {name:"Servicios", href:"/Servicios-de-desarrollo-web",
        children:[
            {name:"Diseño y desarrollo web", href:"/servicios/diseno-y-desarrollo-web",  img: imgServicio1,},
            {name:"Desarrollo de sistemas web a medida", href:"/servicios/desarrollo-de-sistemas-web-a-medida", img: imgServicio2,},
            {name:"Mantenimiento web", href:"/mantenimiento-web",  img: imgServicio3,},
        ]
    },
    {name:"Proyectos", href:"/nuestros-proyectos-web"},
    {name:"Nosotros", href:"/sobre-nosotros-kcmsmart"},
    {name:"Blog", href:"/blog"},
    {name:"Hablemos", href:"/contactanos"},
]
---

<header  class="flex flex-col items-center fixed top-0 left-0 w-full z-50">
    <div class="w-full bg-primary-light overflow-hidden">
        <div class="animate-marquee whitespace-nowrap text-center p-2 font-light text-sm font-Lexend sm:animate-none">

            <span>🔥Obtén hosting y dominio gratis por 1 año al desarrollar tu sitio web con nosotros </span>
            
        </div>
    </div>
    <nav role="navigation" class="w-full max-w-7xl mx-auto flex items-center justify-between px-4 py-2 lg:py-3 bg-body">
        <a href="/">
            <img src="/logo-kcmsmart.svg" alt="Logo kcmsmart.com" class="w-20 lg:w-32 h-auto" width="128" height="36" />
        </a>

        <!-- Desktop Menu -->
        <ul class="hidden lg:flex items-center gap-8">
            {MenuList.map((e) => {
                const isActivo = e.href === currentPath;
                const hasChildren = e.children && e.children.length > 0;
                return (
                    <li class="relative group font-Lexend uppercase">
                        <a href={e.href}
                        class={`${isActivo ? "text-primary-light font-bold text-sm" : "text-gray text-sm hover:text-primary-light transition-colors duration-300 leading-relaxed"} flex items-center gap-1`}
                        >
                            {e.name}
                            {hasChildren && (
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            )}
                        </a>



                        {hasChildren && (
                            <ul class="absolute top-full left-0 mt-2 w-150 bg-[#1a1a1a] shadow-lg  rounded-lg  invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
                                
                                {e.children!.map((child) => (
                                    <div class="flex flex-flex gap-1 items-center p-5">
                                        <img src={child.img.src} alt={child.name}
                                        class="h-20 w-auto rounded-sm hover:scale-105 transition-transform duration-300 ease-in-out">
                                        <li >
                                            <a href={child.href} class="block px-7  py-4 text-gray text-base font-Lexend leading-tight hover:font-bold hover:text-primary-light transition-all ease-in-out  duration-300">
                                                {child.name}
                                            </a>
                                         </li>
                                    </div>
                                ))}
                            </ul>
                        )}
                    </li>
                )
            })}
        </ul>

        <!-- Mobile Menu Button -->
        <button id="menu-toggle" class="lg:hidden p-2" aria-label="Toggle menu">
            <Icon name="solar:hamburger-menu-bold" class="text-gray size-8" />
        </button>
    </nav>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden lg:hidden w-full bg-[#1a1a1a] shadow-lg rounded-4xl ">
        <ul class="flex flex-col p-4 gap-3">
            {MenuList.map((e) => {
                const isActivo = e.href === currentPath;
                const hasChildren = e.children && e.children.length > 0;
                return (
                    <li>
                        <a href={e.href}
                        class={`${isActivo ? "text-primary-light font-bold" : "text-gray hover:text-primary"} block py-2`}
                        >
                            {e.name}
                        </a>
                        {hasChildren && (
                            <ul class="pl-4">
                                {e.children!.map((child) => (
                                    <div class="flex flex-flex gap-1 items-center mt-1">
                                        <img src={child.img.src} alt={child.name}
                                        class="h-10 w-auto rounded-sm hover:scale-105 transition-transform duration-300 ease-in-out">
                                        <li >
                                            <a href={child.href} class="block px-7  text-gray text-base font-Lexend leading-tight hover:font-bold hover:text-primary-light transition-all ease-in-out  duration-300">
                                                {child.name}
                                            </a>
                                         </li>
                                    </div>
                                ))}
                            </ul>
                        )}
                    </li>
                )
            })}
        </ul>
    </div>
</header>

<script>
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');

    menuToggle?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
        
    });
</script>