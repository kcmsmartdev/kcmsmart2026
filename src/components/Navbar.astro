---
import { Icon } from 'astro-icon/components';
import imgServicio1 from "../assets/img-servicio-1.webp"
import imgServicio2 from "../assets/img-servicio-2.webp"
import imgServicio3 from "../assets/img-servicio-3.webp"

const currentPath = Astro.url.pathname;

interface submenu {
  name: string,
  href: string,
  img: ImageMetadata,
}

interface menuList {
  name: string,
  href: string,
  isCTA?: boolean,
  children?: submenu[],
}

const MenuList: menuList[] = [
  { name: "Inicio", href: "/" },
  {
    name: "Servicios",
    href: "/servicios/diseno-y-desarrollo-web",
    children: [
      { name: "Diseño y desarrollo web", href: "/servicios/diseno-y-desarrollo-web", img: imgServicio1 },
      { name: "Desarrollo de sistemas web a medida", href: "/servicios/desarrollo-de-sistemas-web-a-medida", img: imgServicio2 },
      { name: "Mantenimiento web", href: "/servicios/mantenimiento-web", img: imgServicio3 },
    ]
  },
  { name: "Proyectos", href: "/nuestros-proyectos-web" },
  { name: "Nosotros", href: "/sobre-nosotros-kcmsmart" },
  { name: "Blog", href: "/blog" },
  { name: "Hablemos", href: "/contactanos", isCTA: true },
]
---

<header class="fixed top-0 left-0 w-full z-50 flex flex-col items-center bg-body/70 backdrop-blur-md border border-white/5">


  <div class="w-full bg-primary-light py-2  overflow-hidden ">
    <p class="animate-marquee whitespace-nowrap md:animate-none font-Lexend font-light  text-center text-black text-sm">
        🔥 Obtén hosting y dominio gratis por 1 año al desarrollar tu sitio web
    </p>
  </div>


  <nav class="w-full max-w-7xl mx-auto flex items-center justify-between px-4 py-3 
  ">


    <a href="/">
      <img src="/logo-kcmsmart.svg" alt="Logo kcmsmart.com" class="w-24 lg:w-32" width="96px" height="128px" />
    </a>


    <ul class="hidden lg:flex items-center gap-10">
      {MenuList.map((e) => {
        const isActivo = e.href === currentPath;
        const hasChildren = e.children && e.children.length > 0;

        return (
          <li class="relative group font-Lexend uppercase">

            {/* LINK */}
            <a href={e.href}
              class={`${e.isCTA
                ? "bg-primary-light text-black px-4 py-2 rounded-lg font-semibold hover:scale-105 transition"
                : `relative text-sm transition-colors duration-300 ${isActivo ? "text-primary-light font-semibold" : "text-gray hover:text-white"}`}`
              }
            >
              {e.name}

              {!e.isCTA && (
                <span class="absolute left-0 -bottom-1 h-0.5 w-0 bg-primary-light transition-all duration-300 group-hover:w-full"></span>
              )}
            </a>

            {/* DROPDOWN */}
            {hasChildren && (
              <ul class="absolute top-full left-0 mt-4 w-125
              bg-body border border-white/10 rounded-2xl p-4 
              opacity-0 invisible group-hover:opacity-100 group-hover:visible 
              transition-all duration-300 shadow-2xl backdrop-blur-md">

                {e.children!.map((child) => (
                  <li class="flex items-center gap-4 p-3 rounded-xl hover:bg-white/5 transition">
                    <img src={child.img.src} alt="imagen servicio"
                      class="w-16 h-16 object-cover rounded-md">

                    <div>
                      <a  href={child.href} class="text-white text-sm font-medium">{child.name}</a>
                    </div>
                  </li>
                ))}

              </ul>
            )}

          </li>
        )
      })}
    </ul>

    <!-- Mobile Button -->
    <button id="menu-toggle"
    aria-label="menu" 
    class="lg:hidden p-2" >
      <Icon name="solar:hamburger-menu-bold" class="text-gray size-8" />
    </button>
  </nav>

  <div id="mobile-menu"
    class="fixed top-0 right-0 mt-28  w-full
     bg-body backdrop-blur-md border shadow-2xl border-white/5
    translate-x-full transition-transform duration-300 
    z-50 p-6 rounded-l-2xl">

  

    <div>
        <ul class="flex flex-col gap-6 mt-5">
      {MenuList.map((e) => {
        const hasChildren = e.children && e.children.length > 0;
        const isActivo = e.href === currentPath;
        return (
          <li>
            <a href={e.href}
              class={`${e.isCTA
                ? " text-black rounded-lg font-semibold inline-block"
                : "text-gray text-lg hover:text-white"}
                ${isActivo ? "text-primary-light font-semibold" : "text-gray hover:text-white"}`
                
              }
            >
              {e.name}
            </a>

            {hasChildren && (
              <ul class="mt-3 flex flex-col gap-3 pl-2">
                {e.children!.map((child) => (
                  <li class="flex items-center gap-3">
                    <img src={child.img.src} class="w-10 h-10 rounded-md" alt="imagen servicio" />
                    <a href={child.href} class="text-gray text-sm hover:text-white">
                      {child.name}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        )
      })}
    </ul>
    </div>
  </div>

</header>

<!-- 🔥 SCRIPT -->
<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  menuToggle?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('translate-x-full');
  });

  // sombra al hacer scroll
  window.addEventListener("scroll", () => {
    const nav = document.querySelector("nav");
    if (window.scrollY > 10) {
      nav?.classList.add("shadow-lg", "shadow-black/20");
    } else {
      nav?.classList.remove("shadow-lg", "shadow-black/20");
    }
  });
</script>