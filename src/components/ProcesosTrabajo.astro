---
// Proceso.astro
const pasos = [
  {
    num: "01",
    titulo: "Análisis",
    desc: "Entendemos tu negocio, tu competencia y tus objetivos. Definimos el alcance del proyecto y la estrategia digital más adecuada para ti.",
    tags: ["Reunión inicial", "Brief", "Estrategia"],
    icon: "ic:baseline-search",
  },
  {
    num: "02",
    titulo: "Diseño",
    desc: "Creamos una propuesta visual moderna y enfocada en conversión. Wireframes, paleta de colores y prototipo aprobado antes de programar.",
    tags: ["UI/UX", "Prototipo", "Aprobación"],
    icon: "ic:baseline-design-services",
  },
  {
    num: "03",
    titulo: "Desarrollo",
    desc: "Construimos tu sitio web optimizado, rápido y funcional usando tecnologías modernas como Astro, React y Tailwind CSS.",
    tags: ["Astro", "Tailwind", "TypeScript"],
    icon: "ic:baseline-code",
  },
  {
    num: "04",
    titulo: "Lanzamiento",
    desc: "Publicamos tu web optimizada para SEO, conectamos el dominio y te entregamos todo funcionando para atraer clientes desde el primer día.",
    tags: ["SEO", "Deploy", "Soporte"],
    icon: "ic:baseline-rocket-launch",
  },
]
---

<section class="max-w-7xl mx-auto p-4 mt-32">

  <div class="flex flex-col gap-3 mb-16 items-center text-center">
    <span class="font-Anton text-xs tracking-widest text-primary-light uppercase">
      Metodología
    </span>
    <h2 class="font-Anton text-3xl
      bg-linear-to-r from-primary-light via-primary-dark to-primary-light
      bg-size-[300%_300%] bg-clip-text text-transparent animate-gradiente">
      CÓMO TRABAJAMOS
    </h2>
    <p class="max-w-xl font-Lexend text-gray text-base leading-relaxed">
      En KCMSMART seguimos un proceso claro y eficiente para garantizar
      resultados de calidad en cada proyecto.
    </p>
  </div>

  <div class="relative max-w-2xl mx-auto flex flex-col" id="proceso-steps">

    <!-- Línea vertical -->
    <div class="absolute left-[26px] top-14 bottom-14 w-px bg-white/5">
      <div id="proceso-line" class="bg-primary w-full transition-all duration-500 ease-in-out" style="height:0%"></div>
    </div>

    {pasos.map((paso, i) => (
      <div
        class="proceso-step flex gap-5 items-start py-5 cursor-pointer relative z-10"
        data-index={i}
      >
        <!-- Círculo -->
        <div class="proceso-num w-14 h-14 rounded-full border border-white/10 bg-[#1a1a1a]
          flex items-center justify-center shrink-0
          transition-all duration-300">
          <span class="font-Anton text-base text-white/20 proceso-num-text transition-all duration-300">
            {paso.num}
          </span>
        </div>

        <!-- Contenido -->
        <div class="flex flex-col pt-1 min-w-0">
          <span class="font-Anton text-xs tracking-widest text-primary-light/0 proceso-label
            transition-all duration-300 mb-1">
            PASO {paso.num}
          </span>
          <h3 class="font-Anton text-xl text-white/30 proceso-title transition-all duration-300">
            {paso.titulo}
          </h3>
          <p class="font-Lexend text-gray text-sm leading-relaxed proceso-desc
            max-h-0 overflow-hidden opacity-0 transition-all duration-400 ease-in-out">
            {paso.desc}
          </p>
          <div class="flex flex-wrap gap-2 proceso-tags opacity-0 transition-all duration-300 mt-0">
            {paso.tags.map(tag => (
              <span class="font-Anton text-xs px-3 py-1 rounded-full border border-primary-light/20 text-primary-light/60">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>
    ))}

  </div>
</section>

<script>
  const steps = document.querySelectorAll<HTMLElement>('.proceso-step');
  const line = document.getElementById('proceso-line');
  const total = steps.length;

  function setActive(idx: number) {
    steps.forEach((s, i) => {
      const num = s.querySelector('.proceso-num') as HTMLElement;
      const numText = s.querySelector('.proceso-num-text') as HTMLElement;
      const label = s.querySelector('.proceso-label') as HTMLElement;
      const title = s.querySelector('.proceso-title') as HTMLElement;
      const desc = s.querySelector('.proceso-desc') as HTMLElement;
      const tags = s.querySelector('.proceso-tags') as HTMLElement;

      if (i === idx) {
        num.classList.add('!border-primary', '!bg-primary');
        numText.classList.add('!text-white');
        label.classList.remove('text-primary-light/0');
        label.classList.add('text-primary-light');
        title.classList.replace('text-white/30', 'text-white');
        desc.classList.remove('max-h-0', 'opacity-0');
        desc.classList.add('max-h-32', 'opacity-100', 'mt-2');
        tags.classList.remove('opacity-0', 'mt-0');
        tags.classList.add('opacity-100', 'mt-3');
      } else {
        num.classList.remove('!border-primary', '!bg-primary');
        numText.classList.remove('!text-white');
        label.classList.add('text-primary-light/0');
        label.classList.remove('text-primary-light');
        if (i < idx) {
          title.classList.replace('text-white/30', 'text-white/60');
        } else {
          title.classList.remove('text-white/60');
          title.classList.add('text-white/30');
        }
        desc.classList.add('max-h-0', 'opacity-0');
        desc.classList.remove('max-h-32', 'opacity-100', 'mt-2');
        tags.classList.add('opacity-0', 'mt-0');
        tags.classList.remove('opacity-100', 'mt-3');
      }
    });

    if (line) line.style.height = (idx / (total - 1) * 100) + '%';
  }

  // Auto-avanza
  let cur = 0;
  setActive(cur);
  let timer = setInterval(() => {
    cur = (cur + 1) % total;
    setActive(cur);
  }, 2800);

  // Click manual cancela el auto
  steps.forEach((s, i) => {
    s.addEventListener('click', () => {
      clearInterval(timer);
      setActive(i);
    });
  });
</script>