    </div>

  </div>
</div>

<script>
  const container = document.getElementById('projects-container');
  const rows = container?.querySelectorAll('[data-row]');
  const allCards = container?.querySelectorAll('[data-card]');

  function isMobile() {
    return window.innerWidth < 768;
  }

  function setActive(activeCard: Element | null) {
    if (isMobile()) {
  // 🔥 MOBILE: NO acordeón
  allCards?.forEach(card => {
    const el = card as HTMLElement;

    el.classList.remove('flex-[1]', 'flex-[2]', 'flex-[5]');
    el.classList.add('flex-none'); // o simplemente nada

    const grid = el.querySelector('[data-grid]');
    const content = el.querySelector('[data-content]');

    // 🔥 Mostrar SIEMPRE contenido en mobile
    el.dataset.active = 'true';
    if (content) content.dataset.active = 'true';
    if (grid) {
      grid.dataset.active = 'true';
      (grid as HTMLElement).style.gridTemplateColumns = '1fr';
    }
  });

  return; // ⛔ importante: salir aquí
} else {
      // En desktop: acordeón horizontal global con las 4 cards
      allCards?.forEach(card => {
        const isActive = card === activeCard;
        const el = card as HTMLElement;

        el.classList.remove('flex-[1]', 'flex-[2]', 'flex-[5]');
        el.classList.add(isActive ? 'flex-[5]' : 'flex-[1]');

        const grid = el.querySelector('[data-grid]') as HTMLElement;
        const content = el.querySelector('[data-content]') as HTMLElement;

        if (isActive) {
          el.dataset.active = 'true';
          if (content) content.dataset.active = 'true';
          if (grid) {
            grid.dataset.active = 'true';
            grid.style.gridTemplateColumns = '1fr 1fr';
            grid.style.gridTemplateRows = '1fr';
          }
        } else {
          delete el.dataset.active;
          if (content) delete content.dataset.active;
          if (grid) {
            delete grid.dataset.active;
            grid.style.gridTemplateColumns = '1fr 0px';
            grid.style.gridTemplateRows = '1fr';
          }
        }
      });
    }
  }

  // Activar primera card de cada fila al inicio
  if (isMobile()) {
    rows?.forEach(row => {
      const firstCard = row.querySelector('[data-card]');
      if (firstCard) setActive(firstCard);
    });
  } else {
    const firstCard = allCards?.[0];
    if (firstCard) setActive(firstCard);
  }

  allCards?.forEach(card => {
    card.addEventListener('mouseenter', () => setActive(card));
    card.addEventListener('click', () => setActive(card));
  });

  window.addEventListener('resize', () => {
    if (isMobile()) {
      rows?.forEach(row => {
        const activeCard = row.querySelector('[data-card][data-active="true"]') 
          || row.querySelector('[data-card]');
        if (activeCard) setActive(activeCard);
      });
    } else {
      const activeCard = container?.querySelector('[data-card][data-active="true"]') 
        || allCards?.[0];
      if (activeCard) setActive(activeCard as Element);
    }
  });
</script>