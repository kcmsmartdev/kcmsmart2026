---

---

<div
  id="cookie-banner"
  class="fixed bottom-4 left-1/2 z-50 w-[95%] max-w-xl -translate-x-1/2
  rounded-3xl border border-white/10 bg-primary-light/95 backdrop-blur-xl
  shadow-2xl p-5 md:p-6 hidden"
>
  <p class="font-Lexend text-sm md:text-base leading-relaxed text-black/90">
    Utilizamos cookies para mejorar tu experiencia, analizar el tráfico del sitio
    y optimizar nuestros servicios. Al continuar navegando, aceptas nuestro uso
    de cookies según nuestra
    
    <a
      href="/politica-de-cookies"
      class="underline underline-offset-4 font-medium hover:opacity-80 transition"
    >
      política de privacidad
    </a>.
  </p>

  <div class="mt-5 flex flex-col sm:flex-row gap-3">
    
    <button
      id="accept-cookies"
      class="bg-primary text-white px-12 py-3 rounded-2xl
      font-Anton tracking-wide hover:rounded-4xl
      transition-transform duration-300 ease-in-out cursor-pointer"
    >
      Aceptar
    </button>

    <button
      id="reject-cookies"
      class="px-6 py-3 rounded-2xl border border-white/15
      text-black/80 font-Lexend hover:bg-white/10
      transition duration-300 cursor-pointer"
    >
      Rechazar
    </button>

  </div>
</div>


<script>
  const banner = document.getElementById("cookie-banner");
  const acceptBtn = document.getElementById("accept-cookies");
  const rejectBtn = document.getElementById("reject-cookies");

  const cookieChoice = localStorage.getItem("cookie-consent");

  // Mostrar solo si aún no eligió
  if (!cookieChoice && banner) {
    banner.classList.remove("hidden");
  }

  function saveCookieChoice(choice: string) {
    localStorage.setItem("cookie-consent", choice);

    if (banner) {
      banner.classList.add("hidden");
    }
  }

  acceptBtn?.addEventListener("click", () => {
    saveCookieChoice("accepted");
  });

  rejectBtn?.addEventListener("click", () => {
    saveCookieChoice("rejected");
  });
</script>