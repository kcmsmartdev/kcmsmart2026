---
// Blog.astro
import { Icon } from 'astro-icon/components'

const articulos = [
  {
  
    fecha: "12 may 2025",
    titulo: "¿Cuánto cuesta una página web en Perú en 2026?",
    extracto: " Una de las preguntas más comunes antes de crear un sitio web es cuánto cuesta realmente...",
    href: "/blog/cuanto-cuesta-una-pagina-web-en-peru-en-2026",
    img: "https://images.unsplash.com/photo-1542744095-291d1f67b221?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
  },
  {

    fecha: "3 may 2025",
    titulo: "¿Cuándo necesita tu empresa un sistema a medida?",
    extracto: "Muchas empresas comienzan gestionando sus procesos con herramientas básicas como Excel...",
    href: "/blog/cuando-necesita-tu-empresa-un-sistema-a-medida",
    img:"https://images.unsplash.com/photo-1498050108023-c5249f4df085?q=80&w=1172&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
  },
  {

    fecha: "24 abr 2025",
    titulo: "¿Por qué mi página web no aparece en Google?",
    extracto: "Tener una página web no garantiza que aparezca en Google. Muchas empresas publican su sitio...",
    href: "/blog/por-que-mi-pagina-web-no-aparece-en-google",
    img:"https://images.unsplash.com/photo-1556155092-490a1ba16284",
  },
]
---

<div class="max-w-7xl mx-auto p-4 flex flex-col mt-28">
  <section class="flex flex-col gap-3 items-center">

    <h2 class="text-2xl font-Anton text-center text-white mb-4">
    ARTÍCULOS DEL BLOG
  </h2>
    <p class="max-w-xl font-Lexend text-gray text-base leading-relaxed text-center">
      Consejos, guías y tendencias sobre diseño web, desarrollo y posicionamiento digital
      para hacer crecer tu negocio.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-6 mt-16">

      {articulos.map((art) => (
        <section class="flex flex-col gap-4 group">

          
          <div class="overflow-hidden rounded-4xl group-hover:rounded-4xl transition-all duration-300 ease-in-out relative">
            <img
              src={art.img}
              alt="titulo blog"
              class="w-full h-56 object-cover transition-transform duration-700 group-hover:scale-105"
            />
            
          </div>

          <!-- Meta -->
          <div class="flex items-center gap-2 font-Lexend text-xs text-gray">
            <span>{art.fecha}</span>
            <span class="w-1 h-1 rounded-full bg-gray"></span>
            
          </div>

          <!-- Título -->
          <h3 class="font-Anton text-2xl text-gray group-hover:text-primary-light transition-colors duration-300">
            {art.titulo}
          </h3>

          <!-- Extracto -->
          <p class="font-Lexend text-gray text-base leading-relaxed">
            {art.extracto}
          </p>

          
          <a href={art.href}
            class="font-Anton text-gray p-3 flex gap-5 items-center rounded-2xl
            group-hover:rounded-4xl border-2 border-gray-dark
            group-hover:border-transparent group-hover:bg-primary-light group-hover:text-black
            transition-all duration-700 ease-in-out">
            Leer artículo...
            <Icon name="icon-park-outline:arrow-right-up" class="size-7  rotate-45 lg:rotate-0   group-hover:rotate-45 transition-transform duration-500 ease-in-out" />
          </a>

        </section>
      ))}

    </div>

 
    <div class="flex justify-end mt-6">
      <a href="/blog"
        class="font-Anton text-gray text-sm flex items-center gap-2
        group
        hover:text-primary-light transition-colors duration-300">
        VER TODOS LOS ARTÍCULOS
        <Icon name="icon-park-outline:arrow-right-up" class="size-4 group-hover:rotate-45 transition-transform duration-300 ease-in-out " />
      </a>
    </div>

  </section>
</div>