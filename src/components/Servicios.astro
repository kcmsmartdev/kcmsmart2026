---
import { Icon } from "astro-icon/components";
import imgServicio1 from '../assets/img-servicio-1.webp';
import imgServicio2 from '../assets/img-servicio-2.webp';
import imgServicio3 from '../assets/img-servicio-3.webp';
---

<div class="max-w-7xl mx-auto p-4 flex flex-col mt-32">
    <section class="flex flex-col gap-3">
        <h2 class="font-Anton text-3xl leading-12 
        bg-linear-to-r from-primary-light via-primary-dark to-primary-light
         bg-size-[300%_300%]
         bg-clip-text text-transparent
         animate-gradiente">
            NUESTROS SERVICIOS
        </h2>
        <p class="max-w-xl font-Lexend text-gray text-base leading-relaxed">
            Ofrecemos soluciones digitales enfocadas en desarrollo web y sistemas a medida, diseñadas para mejorar la presencia digital y optimizar los procesos de tu negocio.
        </p>

        <div class="mx-auto grid  grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-6 mt-16">
            
            <section class=" flex flex-col gap-4 group ">
                
                <div class="overflow-hidden rounded-4xl group-hover:rounded-[128px] transform duration-300 ease-in-out">
                    <img 
                        src={imgServicio1.src} 
                        alt="Servicio de Diseño y desarrollo web"
                        class="w-full h-full object-cover transform duration-700  group-hover:scale-105"
                    >
                </div>
                <h3 class="font-Anton text-2xl text-gray group-hover:text-primary-light">
                    Diseño y desarrollo web
                </h3>
                <p class="font-Lexend text-gray text-base">
                    Creamos sitios web rápidos, funcionales y optimizados para SEO, diseñados para ofrecer una experiencia clara y representar tu negocio de forma profesional en internet.
                </p>

                <a href="#" class="font-Anton text-gray p-3 flex gap-5 items-center rounded-2xl group-hover:rounded-4xl  border-2 border-gray-dark group-hover:border-transparent
                group-hover:bg-primary-light group-hover:text-black transform duration-700 ease-in-out  ">
                    Ver servicio...
                     <Icon name="icon-park-outline:arrow-right-up" class="size-7  rotate-45 lg:rotate-0   group-hover:rotate-45 transition-transform duration-500 ease-in-out" />
                </a>
            </section>

             <section class=" flex flex-col gap-4 group ">
                
                <div class="overflow-hidden rounded-4xl group-hover:rounded-[128px] transform duration-300 ease-in-out">
                    <img 
                        src={imgServicio2.src} 
                        alt="Servicio de Desarrollo de sistemas web"
                        class="w-full h-full object-cover transform duration-700  group-hover:scale-105 "
                    >
                </div>
                <h3 class="font-Anton text-2xl text-gray group-hover:text-primary-light">
                    Desarrollo de sistemas web
                </h3>
                <p class="font-Lexend text-gray text-base">
                    Desarrollamos sistemas personalizados como paneles administrativos, dashboards y herramientas de gestión, adaptados a los procesos específicos de tu negocio.
                </p>

                <a href="#" class="font-Anton text-gray p-3 flex gap-5 items-center rounded-2xl group-hover:rounded-4xl  border-2 border-gray-dark group-hover:border-transparent
                group-hover:bg-primary-light group-hover:text-black transform duration-700 ease-in-out  ">
                    Ver servicio ...
                     <Icon name="icon-park-outline:arrow-right-up" class="size-7  rotate-45 lg:rotate-0   group-hover:rotate-45 transition-transform duration-500 ease-in-out" />
                </a>
            </section>



             <section class=" flex flex-col gap-4 group ">
                
                <div class="overflow-hidden rounded-4xl group-hover:rounded-[128px] transform duration-300 ease-in-out">
                    <img 
                        src={imgServicio3.src} 
                        alt="Servicio de Mantenimiento web"
                        class="w-full h-full object-cover transform duration-700  group-hover:scale-105"
                    >
                </div>
                <h3 class="font-Anton text-2xl text-gray group-hover:text-primary-light">
                    Mantenimiento web
                </h3>
                <p class="font-Lexend text-gray text-base">
                    Nos encargamos de mantener tu sitio actualizado, optimizado y funcionando correctamente, con soporte continuo para proyectos desarrollados por KCM SMART.
                </p>

                <a data-touch href="#" class="font-Anton text-gray p-3 flex gap-5 items-center rounded-2xl group-hover:rounded-4xl  border-2 border-gray-dark group-hover:border-transparent
                group-hover:bg-primary-light group-hover:text-black transform duration-700 ease-in-out  ">
                    Ver servicio ...
                     <Icon name="icon-park-outline:arrow-right-up" class="size-7  rotate-45 lg:rotate-0   group-hover:rotate-45 transition-transform duration-500 ease-in-out" />
                </a>
            </section>

            

     
         
        </div>
    </section>
    
</div>