
---
import logoReact from '../assets/logos/logo-react.svg'
import logoAstro from '../assets/logos/logo-astro.svg'
import logoPhp from '../assets/logos/logo-php.svg'
import logoTypescript from '../assets/logos/logo-typescript.svg'
import logoSupabase from '../assets/logos/logo-supabase.svg'
import logoTailwind from '../assets/logos/logo-tailwind.svg'

---
<div class="max-w-7xl mx-auto p-4 flex flex-wrap gap-4 items-center justify-evenly mt-32">

    <img src={logoReact.src} alt="logo react" class="h-6 lg:h-8 w-auto" width="88" height="32">
    <img src={logoAstro.src} alt="logo astro" class="h-6 lg:h-8 w-auto" width="88" height="32">
    <img src={logoPhp.src} alt="logo php" class="h-6 lg:h-8 w-auto" width="88" height="32">
    <img src={logoTypescript.src} alt="logo typescript" class="h-7 lg:h-8 w-auto" width="88" height="32">
    <img src={logoSupabase.src} alt="logo supabase" class="h-6 lg:h-8 w-auto" width="88" height="32">
    <img src={logoTailwind.src} alt="logo tailwind" class="h-6 lg:h-8 w-auto" width="88" height="32">
</div>